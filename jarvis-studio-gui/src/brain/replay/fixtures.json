[
  {
    "name": "a TV follow-up 'resume' claimed without a tool call is rechecked, then done for real",
    "source": "live 2026-09-30 on SM-E156B: 'Resumed — back to Arcane' with no tool call (docs/STATUS.md, TV control)",
    "context": {
      "tvPaired": true
    },
    "history": [
      {
        "role": "user",
        "content": "play stranger things on the tv"
      },
      {
        "role": "assistant",
        "content": "Playing Stranger Things on Netflix."
      },
      {
        "role": "user",
        "content": "pause"
      },
      {
        "role": "assistant",
        "content": "Paused Netflix."
      }
    ],
    "user": "resume",
    "model": [
      {
        "text": "Resumed — back to Arcane."
      },
      {
        "toolCalls": [
          {
            "name": "tv_control",
            "args": {
              "action": "resume"
            }
          }
        ]
      },
      {
        "text": "Netflix is playing again on the TV."
      }
    ],
    "results": [
      {
        "ok": true,
        "summary": "Netflix is playing."
      }
    ],
    "expect": {
      "specs": [
        {
          "type": "tv_control",
          "do": "resume"
        }
      ],
      "reply": "playing",
      "offered": ["tv_control"]
    },
    "live": {
      "firstTool": "tv_control",
      "firstArgs": {
        "action": "resume"
      }
    }
  },
