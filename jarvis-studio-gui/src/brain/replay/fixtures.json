  {
    "name": "a planner request uses the planner tools the words loaded",
    "source": "tool groups (2026-10-19): cue words pre-load a group so the common turn never pays load_tools",
    "context": {},
    "user": "every weekday at 7 give me the weather — make that a routine called morning",
    "model": [
      {
        "toolCalls": [
          {
            "name": "manage_routine",
            "args": {
              "action": "add",
              "name": "morning",
              "prompt": "give me the weather",
              "time": "07:00",
              "days": "weekdays"
            }
          }
        ]
      },
      {
        "text": "Saved “morning” for 07:00 on weekdays."
      }
    ],
    "results": [
      {
        "ok": true,
        "summary": "Saved “morning” for 07:00 (weekdays)."
      }
    ],
    "expect": {
      "specs": [
        {
          "type": "routine",
          "do": "add",
          "time": "07:00",
          "days": "weekdays"
        }
      ],
      "offered": ["manage_routine"]
    },
    "live": {
      "firstTool": "manage_routine",
      "firstArgs": {
        "action": "add"
      }
    }
  }
