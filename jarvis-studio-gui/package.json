{
  "name": "jarvis-studio-gui",
  "private": true,
  "version": "2.5.6-rc.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node setup-icons.js",
    "tauri:build": "npm run icons && tauri build",
    "android:build": "tauri android build --apk",
    "android:build:debug": "tauri android build --debug --apk",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:live": "vitest run replay.live --silent=false",
    "test:tool-evals": "vitest run src/brain/replay/evaluation.test.ts src/brain/replay/replay.test.ts src/brain/index.test.ts src/brain/loop.test.ts src/brain/directCommands.test.ts src/brain/recovery.test.ts src/brain/toolMetrics.test.ts src/components/AgentActivity.test.jsx --silent=false",
    "test:workflow": "vitest run src/brain/workflow.test.ts src/brain/results.test.ts src/brain/completion.test.ts",
    "test:foundation": "vitest run src/brain/workflow.test.ts src/brain/loop.test.ts src/brain/ecosystemHealth.test.ts src/hooks/workflowTasks.test.ts src/hooks/taskCenter.test.ts src/brain/schedule/routines.test.ts src/brain/remote/pc.test.ts src/brain/remote/tv.test.ts src/brain/whatsapp.test.ts",
    "test:contracts": "node ../scripts/check-contracts.mjs",
    "test:release-gate": "node --test ../scripts/foundation-gate.test.mjs",
    "check:foundation-gate": "node ../scripts/foundation-gate.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/share-tech-mono": "^5.2.7",
    "@tauri-apps/api": "~2.10.1",
    "@tauri-apps/plugin-biometric": "^2.3.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^6.15.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
