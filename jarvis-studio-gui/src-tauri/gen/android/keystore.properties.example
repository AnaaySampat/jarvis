# Copy to keystore.properties and fill in after creating a release keystore.
# On Windows, escape backslashes in storeFile (e.g. C:\\Users\\you\\jarvis-release.jks).
#
# keytool -genkey -v -keystore jarvis-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias jarvis
#
storeFile=jarvis-release.jks
password=your-keystore-password
keyAlias=jarvis
