<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ANDROID FORK: microphone for voice input (push-to-talk → Groq Whisper STT).
         The Wry WebChromeClient.onPermissionRequest grants getUserMedia at runtime
         once these are declared. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- ANDROID FORK: camera for QR-code pairing (scan the PC's pairing code instead
         of typing it) — same getUserMedia grant path as the microphone above. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- ANDROID FORK: draw the cross-app floating STOP button over other apps when the
         accessibility service ISN'T enabled (voice-only users never turn it on, yet
         still need a STOP reachable while JARVIS is speaking and they're in another
         app). With the a11y service running we use a TYPE_ACCESSIBILITY_OVERLAY and
         this permission is unused; without it we fall back to TYPE_APPLICATION_OVERLAY,
         which requires this SYSTEM_ALERT_WINDOW ("draw over other apps") grant. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Package-visibility (API 30+): without this, queryIntentActivities() in
         PhonePlugin.kt's launchApp() sees no other installed apps, so open_app
         silently fails to resolve almost every third-party/OEM app by name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Alarms/timers are handed to the user's real Clock app via the public
             AlarmClock intents (PhonePlugin.clockAction). Without these entries,
             resolveActivity() returns null on API 30+ even when a Clock app is
             installed, so JARVIS would report "no clock app" on every phone. -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_TIMERS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DISMISS_TIMER" />
        </intent>
        <!-- Calendar: the ACTION_INSERT fallback used when the user hasn't granted
             WRITE_CALENDAR, and ACTION_VIEW for "show me my calendar". Same API 30+
             resolveActivity requirement as the clock intents above. -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.jarvis_studio_gui"
        android:allowBackup="false"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
